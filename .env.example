# MSC Website — Environment Variables
# Copy this file to .env.local and fill in the values
# Never commit .env.local — it's in .gitignore

# ─── Cloudflare D1 Database ────────────────────────────────────────
# Get these from: https://dash.cloudflare.com → Workers & Pages → D1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# ─── Local Development ─────────────────────────────────────────────
# For local dev, use `npm run db:create` and `npm run db:migrate`
# No additional env vars needed — wrangler handles local D1.
