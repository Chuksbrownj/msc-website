{
  "name": "msc-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "bash scripts/db-setup.sh",
    "db:create": "npx wrangler d1 create msc-website-db --local",
    "db:migrate": "npx wrangler d1 execute msc-website-db --local --file=db/migrations/0001_initial.sql",
    "db:migrate:remote": "npx wrangler d1 execute msc-website-db --remote --file=db/migrations/0001_initial.sql",
    "db:query": "npx wrangler d1 execute msc-website-db --local --command 'SELECT * FROM contact_submissions ORDER BY created_at DESC LIMIT 10'",
    "db:reset": "npx wrangler d1 execute msc-website-db --local --command 'DROP TABLE IF EXISTS contact_submissions'"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250818.0",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1",
    "wrangler": "^3.114.5"
  }
}
